
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    // Default deny. Buka akses hanya melalui rules yang sudah diuji atau Admin SDK di Functions.
    match /{document=**} { allow read, write: if false; }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /candidates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /electionSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // voters, OTP challenges, ballots, audit logs: akses via backend terotorisasi.
  }
}
